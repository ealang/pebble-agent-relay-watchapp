{
  "name": "operator",
  "author": "deltaloop",
  "version": "1.0.0",
  "keywords": [
    "pebble-app"
  ],
  "private": true,
  "dependencies": {
    "@rebble/clay": "^1.0.8"
  },
  "pebble": {
    "displayName": "Operator",
    "uuid": "c0b48501-a0da-4fbb-9013-a4ea68dc6165",
    "sdkVersion": "3",
    "targetPlatforms": [
      "basalt",
      "chalk",
      "diorite",
      "emery",
      "flint",
      "gabbro"
    ],
    "watchapp": {
      "watchface": false
    },
    "messageKeys": {
      "TRANSCRIPT": 10000,
      "REVIEW_DELAY": 10001,
      "SENT_SCREEN": 10002,
      "RECORDED_AT": 10003
    },
    "companionApp": {
      "android": {
        "apps": [
          {
            "package": "io.github.ealang.operator"
          }
        ],
        "required": true
      }
    },
    "resources": {
      "media": [
        { "type": "bitmap", "name": "IMAGE_MENU_ICON", "file": "images/menu_icon.png", "menuIcon": true },
        { "type": "bitmap", "name": "ICON_CHECK", "file": "images/icon_check.png" },
        { "type": "bitmap", "name": "ICON_UP", "file": "images/icon_up.png" },
        { "type": "bitmap", "name": "ICON_DOWN", "file": "images/icon_down.png" }
      ]
    },
    "enableMultiJS": true,
    "capabilities": [
      "configurable"
    ]
  }
}
