{
  "name": "voicehook",
  "author": "deltaloop",
  "version": "2.1.0",
  "keywords": [
    "pebble-app"
  ],
  "private": true,
  "dependencies": {
    "@rebble/clay": "^1.0.8"
  },
  "pebble": {
    "displayName": "Voice Hook",
    "uuid": "c0b48501-a0da-4fbb-9013-a4ea68dc6165",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "targetPlatforms": [
      "basalt",
      "chalk",
      "diorite",
      "emery",
      "flint",
      "gabbro"
    ],
    "watchapp": {
      "watchface": false
    },
    "messageKeys": [
      "TRANSCRIPT",
      "CONFIRMATION",
      "ERROR_DIALOGS"
    ],
    "companionApp": {
      "android": {
        "apps": [
          {
            "package": "io.github.ealang.pebbletelegramagent"
          }
        ],
        "required": true
      }
    },
    "resources": {
      "media": []
    },
    "capabilities": [
      "configurable"
    ]
  }
}
